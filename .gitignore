# ---------- 数据（自备，一概不入库）----------
# 本仓库不含任何数据。data/ 仅作投放口：使用者把自备数据放进来，不进 git。
data/raw/*
!data/raw/.gitkeep
!data/DATA_NOTES.md

# ---------- 产出（可复现，不入库）----------
outputs/**
!outputs/**/.gitkeep

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# ---------- 编辑器/系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------- 临时文件 ----------
_tmp/
*.tmp
*.log
